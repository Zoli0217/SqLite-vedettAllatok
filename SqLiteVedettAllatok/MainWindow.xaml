<Window x:Class="SqLiteVedettAllatok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SqLiteVedettAllatok"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        
        <DataGrid x:Name="dataGrid" Grid.Column="0" SelectionMode="Extended" AutoGenerateColumns="True" SelectionUnit="FullRow"/>

        <Button Width="200px" Grid.Column="1" Height="30px" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,10,0,0" Click="deleteBtn">Adat törlése</Button>

        <ComboBox x:Name="osztalyCbx" Grid.Column="1" HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="osztalyCbx_SelectionChanged"/>
        <Label x:Name="avgPriceLb" Grid.Column="1" HorizontalAlignment="Left" Margin="10,90,0,0" VerticalAlignment="Top"/>
        <Button Width="200px" Grid.Column="1" Height="30px" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,10,0,30" Click="resetBtn">Visszaállítás</Button>
        <Button Width="200px" Grid.Column="1" Height="30px" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,50,0,0" Click="updateBtn">Drága állat</Button>
        <Label x:Name="maxPriceLb" Grid.Column="1" HorizontalAlignment="Right" Margin="10,130,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
